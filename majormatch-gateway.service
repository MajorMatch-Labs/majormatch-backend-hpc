[Unit]
Description=MajorMatch Cloud Gateway Persistence Engine
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/gateway
ExecStart=/home/ubuntu/gateway/venv/bin/uvicorn cloud_gateway:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
